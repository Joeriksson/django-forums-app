# Keep secrets and local files out of the image. docker compose passes .env at runtime (env_file).
.env
.env.*

# Version control, CI and editor files
.git
.github
.gitignore
.idea
.vscode

# Documentation and compose files: nothing in the image reads them, and leaving them
# out means a change to them alone doesn't rebuild the image or restart the containers
docs
*.md
docker-compose*.yml

# Local Python environment, caches and test output (the image builds its own venv in /opt/venv)
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.coverage
htmlcov

# Local runtime files; staticfiles/ is built fresh by collectstatic in the Dockerfile
staticfiles
celerybeat-schedule
media

# Copy to .env and fill in. Never commit .env.
# docker compose reads .env for the containers (env_file) and, in production,
# for the ${...} values in docker-compose-prod.yml.
# DEBUG is not read from here: each settings module sets it.

# ---------------------------------------------------------------------------
# Common
# ---------------------------------------------------------------------------

# Required. Long random string, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Production refuses to start with fewer than 50 characters.
SECRET_KEY=change-me

# Required outside production: development, production, CI or test.
# Anything but production runs Celery tasks in the web process.
# Production: leave it out, docker-compose-prod.yml sets it.
ENVIRONMENT=development

# Settings module for manage.py and Celery. Without it, manage.py uses
# project.settings.base (no email backend) and Celery uses production.
# Production: leave it out, docker-compose-prod.yml sets it.
DJANGO_SETTINGS_MODULE=project.settings.development

# Optional, but set it in production. Email addresses, comma-separated, that
# get the traceback of every server error (500) when DEBUG is False.
# Empty: no error emails.
# DJANGO_ADMINS=admin@example.com

# Optional. true lets anyone create an account, by email or GitHub. Closed by
# default (development settings: open). Existing users can always log in.
# DJANGO_SIGNUP_OPEN=false

# Optional. true makes the Content Security Policy report-only: browsers log what
# the policy would block (in their console) instead of blocking it. For finding out
# what a change to the policy breaks; leave it off otherwise.
# DJANGO_CSP_REPORT_ONLY=false

# Optional. true switches the REST API under /api/ on. Off by default (development
# settings: on): the website doesn't use it, and without it every /api/ path is a 404.
# DJANGO_API_ENABLED=false

# Optional. Staff, moderators and anyone else with a permission need two-factor
# authentication (an authenticator app) to use the site, and their API tokens
# are refused. On by default
# (development settings: off). Leave it on in production.
# DJANGO_STAFF_REQUIRE_MFA=true

# Required in production; optional elsewhere (default: http://127.0.0.1:8000).
# The site's public address, used for links in emails such as invitations.
# Production: https, no path, e.g. https://forum.example.com
# DJANGO_SITE_URL=http://127.0.0.1:8000

# Optional. Path of the Django admin (default: nimda). Use your own in production.
# ADMIN_URL=nimda

# Optional. The time zone that dates and times are shown in, the same for every member
# (default: UTC). A tz database name, e.g. Europe/Paris. Logs stay in UTC.
# DJANGO_TIME_ZONE=UTC

# Optional. The language of the interface for visitors who haven't chosen another:
# en (default) or sv.
# DJANGO_LANGUAGE=en

# ---------------------------------------------------------------------------
# Development only (production: leave these out)
# ---------------------------------------------------------------------------

# Optional. Redis URL (default: redis://redis:6379/0, the Docker service).
# The database number is replaced: cache uses /0, Celery uses /1.
# REDIS_URL=redis://redis:6379/0

# Optional. Set to true to use Redis on localhost when running without Docker.
# Ignored when REDIS_URL is set.
# REDIS_LOCALHOST=true

# Optional. Overrides the database settings, e.g. to run without Docker:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Production only (docker-compose-prod.yml)
# ---------------------------------------------------------------------------
# docker-compose-prod.yml builds DATABASE_URL and REDIS_URL from the passwords
# below; don't set them yourself.

# Required. Your domain(s), comma-separated. Also sets CSRF_TRUSTED_ORIGINS.
# If empty, every request gets a 400.
# DJANGO_ALLOWED_HOSTS=forum.example.com

# Required. Encrypts the two-factor secrets (authenticator apps, recovery codes) in
# the database. Generate one with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy outside the server: without this key no stored second factor works,
# also after restoring a database backup. Never change it on a running site.
# DJANGO_MFA_ENCRYPTION_KEY=

# Required. URL-safe characters only (letters, digits, - and _).
# The database superuser, for backups and maintenance. The app doesn't use it.
# POSTGRES_PASSWORD=change-me

# Required. URL-safe characters only. The password of the app's own database role
# (forum). Use a different one than POSTGRES_PASSWORD.
# POSTGRES_APP_PASSWORD=change-me
# REDIS_PASSWORD=change-me

# Required, unless DJANGO_EMAIL_CONSOLE=true. SMTP server and login.
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=forum@example.com
# EMAIL_HOST_PASSWORD=change-me

# Optional. SMTP port and STARTTLS (defaults: 587, true).
# EMAIL_PORT=587
# EMAIL_USE_TLS=true

# Optional. Sender address (default: EMAIL_HOST_USER).
# DEFAULT_FROM_EMAIL=forum@example.com

# Optional. true prints mail to the logs instead of using SMTP.
# Only for trying the production stack out locally.
# DJANGO_EMAIL_CONSOLE=false

# Optional. Number of gunicorn worker processes (default: 2, each handling 4
# requests at a time). Raise it on a server with more CPU cores and memory.
# WEB_CONCURRENCY=2

# Optional. HSTS max-age in seconds (default: 3600). Raise to 31536000 once
# HTTPS works; see docs/deployment-vps.md.
# DJANGO_SECURE_HSTS_SECONDS=3600

# Optional, opt-in (default: false). Only if every subdomain is on HTTPS /
# only to submit the domain to browsers' preload list.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
